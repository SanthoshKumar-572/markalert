datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  full_name     String
  employee_id   String   @unique
  email         String   @unique
  password_hash String
  department    String
  designation   String
  mobile_number String?
  role          String   @default("FACULTY")
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  batches        NotificationBatch[]
  audit_logs     AuditLog[]
  refresh_tokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model NotificationBatch {
  id                  String    @id @default(uuid())
  created_by          String
  creator             User      @relation(fields: [created_by], references: [id])
  exam_name           String
  department          String?
  class_name          String?
  academic_year       String?
  original_file_name  String
  total_records       Int       @default(0)
  valid_records       Int       @default(0)
  invalid_records     Int       @default(0)
  total_notifications Int       @default(0)
  batch_status        String    @default("DRAFT")
  created_at          DateTime  @default(now())
  completed_at        DateTime?

  recipients    BatchRecipient[]
  notifications Notification[]

  @@index([created_by])
  @@index([batch_status])
  @@map("notification_batches")
}

model BatchRecipient {
  id               String            @id @default(uuid())
  batch_id         String
  batch            NotificationBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  register_number  String
  student_name     String
  parent_name      String?
  encrypted_phone  String
  phone_masked     String
  marks_data       String // JSON string: Record<subjectName, { marksObtained: number, maxMarks: number }>
  total_marks      Float
  max_marks        Float
  percentage       Float
  status           String            @default("VALID")
  issues           String? // JSON string: Array<{ field: string, message: string, type: string }>
  created_at       DateTime          @default(now())

  @@index([batch_id])
  @@index([register_number])
  @@map("batch_recipients")
}

model Notification {
  id                  String            @id @default(uuid())
  batch_id            String
  batch               NotificationBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  recipient_reference String // e.g. Register Number / Masked Phone
  channel             String // WHATSAPP | SMS
  message_text        String
  provider_message_id String?
  status              String            @default("PENDING")
  attempts            Int               @default(0)
  sent_at             DateTime?
  delivered_at        DateTime?
  failed_at           DateTime?
  error_code          String?
  error_message       String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  events NotificationEvent[]

  @@index([batch_id])
  @@index([status])
  @@index([channel])
  @@index([provider_message_id])
  @@map("notifications")
}

model NotificationEvent {
  id               String       @id @default(uuid())
  notification_id  String
  notification     Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  event_type       String
  provider_payload String? // Sanitized JSON payload
  created_at       DateTime     @default(now())

  @@index([notification_id])
  @@map("notification_events")
}

model MessageTemplate {
  id            String   @id @default(uuid())
  name          String
  channel       String   @default("BOTH")
  template_text String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("message_templates")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updated_at  DateTime @default(now()) @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entity_id  String?
  details    String?
  ip_address String?
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([action])
  @@map("audit_logs")
}
