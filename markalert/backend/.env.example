# ==============================================================================
# MarkAlert v2 — Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL for Production / Render)
DATABASE_URL=postgresql://postgres:password@localhost:5432/markalert

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Application URLs (CORS & Redirection)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Authentication & JWT Secrets
JWT_SECRET=markalert_jwt_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=markalert_jwt_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis Connection (BullMQ background job queue)
REDIS_URL=redis://localhost:6379

# Mock Mode (Set 'true' for safe development & testing without real sending)
MOCK_NOTIFICATION_PROVIDER=true

# Meta WhatsApp Business Cloud API (Production Credentials)
WHATSAPP_ACCESS_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_VERIFY_TOKEN=markalert_webhook_verify_token_2026

# Indian DLT-Compliant SMS Gateway (Fast2SMS / MSG91)
SMS_API_KEY=your_sms_provider_api_key_here
SMS_API_SECRET=your_sms_provider_api_secret_here
SMS_SENDER_ID=MRKALR
SMS_DLT_TEMPLATE_ID=1107161829000000000

# College & Institution Identity
COLLEGE_NAME=V.S.B. Engineering College, karur.
