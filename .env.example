# Database Connection
# For local SQLite: sqlite:./data/college_sms.sqlite
# For PostgreSQL: postgresql://username:password@localhost:5432/college_sms
DATABASE_URL=sqlite:./data/college_sms.sqlite

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=college_secret_jwt_key_replace_in_production_2026

# WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_TEMPLATE_NAME=internal_marks_alert

# SMS Provider Credentials (Fast2SMS / MSG91 / DLT-compliant)
SMS_API_KEY=sms_provider_api_key_here
SMS_SENDER_ID=ABCENG
SMS_TEMPLATE_ID=1107161829000000000

# College System Settings
COLLEGE_NAME=ABC College of Engineering & Technology

# Mock Provider Mode (True for safe local development without incurring charges)
MOCK_NOTIFICATION_PROVIDER=true
